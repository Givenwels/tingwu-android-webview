<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/playback_capsule_background"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/floating_playback_open"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/playback_item_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/floating_playback_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:textColor="@color/playback_ui_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/floating_playback_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:breakStrategy="simple"
            android:importantForAccessibility="no"
            android:textColor="@color/playback_ui_text_secondary"
            android:textDirection="ltr"
            android:textSize="12sp" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/floating_playback_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/playback_toggle_background"
        android:contentDescription="@string/playback_ui_play"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_playback_play" />

    <ImageButton
        android:id="@+id/floating_playback_close"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/playback_item_background"
        android:contentDescription="@string/playback_ui_floating_close"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_playback_close" />

</LinearLayout>
